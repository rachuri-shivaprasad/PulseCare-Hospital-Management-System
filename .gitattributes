# Normalize line endings across platforms
* text=auto

# Force LF for source files (cross-platform consistency)
*.java text eol=lf
*.jsx  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.properties text eol=lf

# Keep CRLF for Windows batch scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files — do not modify line endings
*.jar  binary
*.class binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
